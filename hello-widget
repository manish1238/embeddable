(function() {
  // we use a namespace so we don’t pollute global scope
  function insertHello() {
    const el = document.createElement("div");
    el.textContent = "Hello from widget!";
    el.style.padding = "10px";
    el.style.border = "1px solid #000";
    el.style.background = "#eef";
    // insert at bottom of body
    document.body.appendChild(el);
  }

  // Expose an init method
  window.HelloWidget = {
    init: function(options) {
      // you could use options (e.g. custom message)
      if (options && options.message) {
        // override the text
        document.createElement("div"); // just placeholder
      }
      insertHello();
    }
  };
})();
